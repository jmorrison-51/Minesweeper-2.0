@* The smiley button: starts a new game. Drawn in SVG on a 32x32 grid. *@
<button class="face-button" title="New game (F2)" aria-label="New game" @onclick="OnClick">
    <svg viewBox="0 0 32 32" width="100%" height="100%">
        <circle cx="16" cy="16" r="11" fill="#ffdd00" stroke="#000" stroke-width="1.5" />
        @switch (Face)
        {
            case FaceKind.Dead:
                <g stroke="#000" stroke-width="1.5">
                    <line x1="10.2" y1="11.2" x2="13.8" y2="14.8" /><line x1="10.2" y1="14.8" x2="13.8" y2="11.2" />
                    <line x1="18.2" y1="11.2" x2="21.8" y2="14.8" /><line x1="18.2" y1="14.8" x2="21.8" y2="11.2" />
                </g>
                <path d="M 11.5 23 Q 16 18.5 20.5 23" fill="none" stroke="#000" stroke-width="1.5" />
                break;
            case FaceKind.Cool:
                <rect x="8.3" y="11" width="15.4" height="3.3" fill="#000" />
                <path d="M 11 18.5 Q 16 23.5 21 18.5" fill="none" stroke="#000" stroke-width="1.5" />
                break;
            case FaceKind.Surprised:
                <circle cx="12" cy="13" r="1.4" /><circle cx="20" cy="13" r="1.4" />
                <ellipse cx="16" cy="21" rx="1.6" ry="2" />
                break;
            default:
                <circle cx="12" cy="13" r="1.4" /><circle cx="20" cy="13" r="1.4" />
                <path d="M 11 18.5 Q 16 23.5 21 18.5" fill="none" stroke="#000" stroke-width="1.5" />
                break;
        }
    </svg>
</button>

@code {
    public enum FaceKind { Smile, Surprised, Dead, Cool }

    [Parameter] public FaceKind Face { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
